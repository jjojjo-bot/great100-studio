# Supabase Dashboard > Project Settings > API: Project URL and publishable key.
# These values are public and included in the web build. Never use a secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only R2 settings for Vercel Functions (or vercel dev).
# Never prefix these credentials with VITE_.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
